# GPS51 API Configuration
NEXT_PUBLIC_GPS51_API_URL=https://api.gps51.com/openapi
NEXT_PUBLIC_GPS51_SERVER_ID=2

# HERE Maps API Configuration (for reverse geocoding)
NEXT_PUBLIC_HERE_API_KEY=your-here-api-key-here

# Application Configuration
PORT=3005
NEXT_PUBLIC_API_URL=http://localhost:3005
NEXT_PUBLIC_APP_NAME=GIGMotors Dashboard
NEXT_PUBLIC_APP_VERSION=1.0.0

# Session Configuration (in milliseconds)
SESSION_TIMEOUT=3600000

# Do not set NODE_ENV in env files used for production builds — it can break prerender.
# Next.js sets NODE_ENV automatically for dev, build, and start.

# Monitoring Service Credentials (mileage JSON cron only)
MONITOR_USERNAME=your-username-here
MONITOR_TOKEN=your-auth-token-here
# MD5 hash of password: node -e "require('crypto').createHash('md5').update('YOUR_PASSWORD').digest('hex')"
MONITOR_PASSWORD=your-md5-hashed-password

# Mileage developer JSON API (optional — if unset, GET /api/mileage-data is open)
MILEAGE_API_KEY=st-key-hV5RCbnuibHJxqrHmWPpoxUm910JaC2V

# Mileage cron schedule (default: 20:00 daily, server local time)
MILEAGE_CRON=0 20 * * *

# Idle/stop developer JSON API (optional — if unset, GET /api/idle-stop-data is open)
IDLE_STOP_API_KEY=your-long-random-secret

# Idle/stop cron schedule (default: 03:00 daily, server local time — previous day)
IDLE_STOP_CRON=0 3 * * *

# Idle/stop scan tuning
# IDLE_STOP_TIMEZONE=8
# IDLE_STOP_MIN_STOP_MINUTES=5
# IDLE_STOP_PARK_INTERVAL_MINUTES=5
# IDLE_STOP_ACC_STATE_ENGINE_ON=3
# IDLE_STOP_ACC_STATE_ENGINE_OFF=2
# IDLE_STOP_IDLE_MAX_METERS=500
# IDLE_STOP_IDLE_MAX_AVG_SPEED_KMH=15
# IDLE_STOP_MIN_IDLE_MINUTES=1
# IDLE_STOP_RATE_LIMIT_MS=5500

# Email Configuration for Overspeed Reports
# Enable/disable email sending (true/false)
ENABLE_EMAIL_REPORTS=false

# SMTP Configuration
# For Gmail: smtp.gmail.com, port 587, use app password (not regular password)
# For Outlook: smtp-mail.outlook.com, port 587
# For custom SMTP: contact your IT department for details
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password

# Email Recipients (comma-separated for multiple addresses)
EMAIL_TO=recipient1@example.com,recipient2@example.com
EMAIL_FROM=alerts@example.com
EMAIL_SUBJECT=Overspeed Alert - Violations Detected
